{
  "$schema": "https://frictionlessdata.io/schemas/table-schema.json",
  "name": "odas-app-spielplatz-finder",
  "title": "Spielplatz-Finder",
  "fields": [
    {
      "name": "ortsteil",
      "title": "Ortsteil",
      "type": "string",
      "description": "Ortsteil des Spielplatzes.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "art",
      "title": "Art",
      "type": "string",
      "description": "Art des Spielplatzes (normalisiert aus spielplatzart), z. B. Kleinkinderspielplatz.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "tischtennis_anzahl",
      "title": "Tischtennis-Anzahl",
      "type": "integer",
      "description": "Zahl der Tischtennisplatten (leer, wenn keine vorhanden).",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "tischtennis",
      "title": "Tischtennis",
      "type": "string",
      "description": "Tischtennisangebot („Ja“ oder leer).",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "lat",
      "title": "Breite",
      "type": "number",
      "description": "Breitengrad aus Geokodierung zur Laufzeit.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "lon",
      "title": "Länge",
      "type": "number",
      "description": "Längengrad aus Geokodierung zur Laufzeit.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "latitude",
      "title": "Breitengrad",
      "type": "number",
      "description": "Breitengrad (Alias aus Quellformaten).",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "longitude",
      "title": "Längengrad",
      "type": "number",
      "description": "Längengrad (Alias aus Quellformaten).",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "spielplatz_name",
      "title": "Spielplatz-Name",
      "type": "string",
      "description": "Name des Spielplatzes (normalisiert aus name).",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "adresse",
      "title": "Adresse",
      "type": "string",
      "description": "Adresse (normalisiert aus strasse, ggf. mit Hausnummer/PLZ).",
      "constraints": {
        "required": false
      }
    }
  ]
}
